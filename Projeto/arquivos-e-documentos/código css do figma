*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}

body{
    background: linear-gradient(to right, #020b1d, #07152d);
    color: white;
}

/* TOPO */

.topbar{
    background-color: #111;
    padding: 15px;
    text-align: center;
}

/* CONTAINER */

.container{
    padding: 20px;
}

/* USUÁRIO */

.welcome{
    margin-bottom: 20px;
}

.welcome p{
    color: #999;
    margin-bottom: 5px;
}

/* CARDS */

.cards{
    display: flex;
    gap: 15px;
    margin-bottom: 25px;
}

.card{
    flex: 1;
    padding: 20px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.1);
}

.card h3{
    margin-top: 10px;
    font-size: 28px;
}

.orange{
    background-color: #3a1709;
}

.blue{
    background-color: #00384d;
}

.purple{
    background-color: #2a1445;
}

/* DESAFIO */

.challenge{
    background-color: #ff5a00;
    padding: 25px;
    border-radius: 15px;
    margin-bottom: 25px;
}

.challenge h2{
    margin: 10px 0;
}

.progress-bar{
    width: 100%;
    height: 10px;
    background-color: rgba(255,255,255,0.3);
    border-radius: 20px;
    overflow: hidden;
    margin: 15px 0;
}

.progress{
    width: 70%;
    height: 100%;
    background-color: white;
}

.challenge button{
    padding: 10px 18px;
    border: none;
    border-radius: 20px;
    cursor: pointer;
}

/* BOTÕES */

.actions{
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
}

.action-btn{
    flex: 1;
    padding: 30px;
    border: none;
    border-radius: 15px;
    color: white;
    font-size: 18px;
}

.register{
    background-color: #00b7e8;
}

.group{
    background-color: #1b273d;
}

/* ATIVIDADES */

.activities{
    background-color: rgba(255,255,255,0.03);
    border-radius: 15px;
    padding: 20px;
}

.activity-item{
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 0;
    border-bottom: 1px solid rgba(255,255,255,0.1);
}

.activity-item p{
    color: #aaa;
}

.points{
    background-color: #ff6a00;
    padding: 8px 14px;
    border-radius: 20px;
}
