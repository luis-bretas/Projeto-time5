<!DOCTYPE html>
<html>
<head>
    <title>Ranking</title>
</head>
<body>

    <h1>Ranking de Usuários</h1>

    <table border="1">
        <tr>
            <th>Posição</th>
            <th>Nome</th>
            <th>Pontos</th>
        </tr>

        {% for usuario in usuarios %}
        <tr>
            <td>{{ forloop.counter }}</td>
            <td>{{ usuario.nome }}</td>
            <td>{{ usuario.pontos }}</td>
        </tr>
        {% endfor %}

    </table>

</body>
</html>
